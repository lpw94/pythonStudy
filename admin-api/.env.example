# 应用配置示例：复制为 .env 后按需修改（.env 已被 gitignore 忽略）

# ---- 基本信息 ----
DEBUG=true

# ---- 数据库 ----
# 默认 SQLite 单文件，路径相对项目根目录
# 换 Postgres 示例：postgresql+psycopg://user:pass@localhost:5432/admin_api
# DATABASE_URL=sqlite:///./admin.db

# ---- JWT ----
# 生产环境必须改！HS256 要求至少 32 字节
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
