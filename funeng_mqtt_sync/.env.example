# 模板：复制为 .env 并填入真实值（.env 已被 git 忽略，不会提交）。
# config.py 会从项目根目录的 .env 读取以下变量（无需 python-dotenv）。
#
# 注意：下面只有 3 项是必填且真正敏感的，缺失时程序启动会直接报错：
FUNENG_PASSWORD_MD5=your_login_password_md5
BAIDU_API_KEY=your_api_key
BAIDU_SECRET_KEY=your_secret_key

# 以下为可选覆盖项（默认值已写在 config.py，一般无需改动）
# FUNENG_HOST_URL=http://111.8.86.3:19126
# FUNENG_MQTT_HOST=121.37.27.139
# FUNENG_MQTT_PORT=1883
# FUNENG_USER_NAME=yh_zhongxyy
# FUNENG_USER_ID=1990
# BAIDU_OCR_ENDPOINT=general_basic
# baidu=百度云识别；ddddocr=本地离线识别（pip install ddddocr，需 Python<=3.12）
# OCR_PROVIDER=ddddocr
