# 模板：复制为 .env 并填入真实值（.env 已被 .git 忽略，不会提交）。
#     Windows 下直接 `copy .env.example .env` 即可。
#
# config.py 从项目根目录的 .env 读取以下变量（无需 python-dotenv）。
# 读取优先级：系统环境变量 > .env > config.py 里的默认值。
#
# ⚠️ 这里**只有占位符**，不要把真实值填进来再提交——.env 已被忽略，
#    但一旦手滑 `git add -f`，敏感值就进了公开仓库的历史。
#    提交前可以用 `python scripts/check_secrets.py` 自查。

# ---- 必填三项 ----------------------------------------------------------

# 生产服务端地址（内网直连，IP 与端口都可能随环境变化）
FUNENG_HOST_URL=http://<内网IP>:<端口>

# 登录账号
FUNENG_USER_NAME=<你的账号>

# 登录密码的 **md5**（不是明文密码）。
# 生成方式：python -c "import hashlib;print(hashlib.md5(b'你的明文密码').hexdigest())"
FUNENG_PASSWORD_MD5=<32位小写md5>

# ---- 设备清单（取数用，必填）-------------------------------------------

# 要取数的水表清单，**一行 JSON 数组**。
# fmAddress = 表地址，meterId = 表号，deviceCode = 设备编号。
# 这三项是真实表号，和地址、账号同一性质——公开仓库里不能出现。
#
# 写法（注意是**一行**，JSON 里的双引号别换成单引号）：
# FUNENG_DEVICES=[{"fmAddress":"<表地址>","meterId":"<表号>","deviceCode":"<设备编号>"}]
#
# 多台表就往数组里加，逗号分隔：
# FUNENG_DEVICES=[{"fmAddress":"<表地址1>","meterId":"<表号1>","deviceCode":"<设备编号1>"},{"fmAddress":"<表地址2>","meterId":"<表号2>","deviceCode":"<设备编号2>"}]
FUNENG_DEVICES=[{"fmAddress":"<表地址>","meterId":"<表号>","deviceCode":"<设备编号>"}]

# ---- 可选覆盖项（默认值已写在 config.py，一般无需改动）---------------

# 请求超时（秒）
FUNENG_HTTP_TIMEOUT=10

# 内网地址必须绕过企业代理，否则验证码会下载成 0 字节或 44 字节的 JSON 错误。
# 改成 0 可恢复「读环境代理」的行为。
FUNENG_BYPASS_ENV_PROXY=1

# 用户 ID。**一般不用填**——登录响应里会返回 data.userId，取数时的 Cookie 头
# 用它。只有服务端不返回时，才需要在这里兜底。
# FUNENG_USER_ID=
