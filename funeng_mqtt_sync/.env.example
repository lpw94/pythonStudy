# 模板：复制为 .env 并填入真实值（.env 已被 git 忽略，不会提交）。
# config.py 会从项目根目录的 .env 读取以下变量（无需 python-dotenv）。
#
# 只有 FUNENG_PASSWORD_MD5 是必填项：它是**登录密码的 md5**（不是明文），
# 缺失时 login 模块会在发请求前明确报错，不会带着空密码去打扰服务端。
FUNENG_PASSWORD_MD5=your_login_password_md5

# 以下为可选覆盖项（默认值已写在 config.py，一般无需改动）
# FUNENG_HOST_URL=http://10.0.0.1:8080
# FUNENG_USER_NAME=your_account
# FUNENG_HTTP_TIMEOUT=10
# 内网地址必须绕过企业代理，否则验证码会下载成 0 字节或 44 字节的 JSON 错误。
# 改成 0 可恢复「读环境代理」的行为。
# FUNENG_BYPASS_ENV_PROXY=1
